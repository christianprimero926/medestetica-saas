# === Variables para docker compose (raíz del proyecto) ===
# DESARROLLO: no necesitas .env; el compose usa defaults (${VAR:-default}).
# PRODUCCIÓN: copia este archivo a `.env.production`, rellena valores reales y
#   despliega con:  docker compose --env-file .env.production up -d
# Nota: un `.env` a secas se cargaría AUTOMÁTICAMENTE también en dev y rompería
#   tu stack local (password vs. volumen existente). Por eso usamos .env.production.
# Los `.env*` reales NO se commitean (.gitignore), excepto este .env.example.
#
# Genera secretos fuertes (>=32 chars) así:
#   POSTGRES_PASSWORD:   openssl rand -hex 24      (hex = seguro dentro de la URL de conexión)
#   JWT_SECRET:          openssl rand -base64 48
#   TENANT_SECRETS_KEY:  openssl rand -base64 36

# Password de la base de datos. Solo se aplica al CREAR el volumen por primera vez.
# Si cambias esto con un volumen ya existente, resetea con `docker compose down -v`
# (borra datos) o cambia la clave dentro de Postgres con ALTER USER.
POSTGRES_PASSWORD=

# Firma de los JWT. Cambiarlo invalida los tokens existentes (obliga a re-login).
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Clave maestra para cifrar secretos por tenant (API keys, etc.) en la BD.
# OJO: si ya hay datos cifrados (prefijo enc:v1:), cambiarla los vuelve ilegibles.
TENANT_SECRETS_KEY=

# Orígenes permitidos por CORS (coma-separados). Sin esto, el backend usa http://localhost:3000.
CORS_ORIGIN=http://localhost:3000

# "true" siembra datos/usuarios demo en cada arranque. En PRODUCCIÓN usa "false".
SEED_ON_START=false

# === Solo para despliegue con imágenes (docker-compose.prod.yml) ===
# Dueño de las imágenes en GHCR (usuario/org de GitHub).
GHCR_OWNER=christianprimero926
# Tag de imagen a desplegar: latest, dev, un vX.Y.Z o un sha corto.
IMAGE_TAG=dev
# Dominio público de la app (Caddy pide el certificado HTTPS para este dominio).
APP_DOMAIN=app.tudominio.com
# Email para Let's Encrypt (avisos de expiración de certificados).
ACME_EMAIL=tu-correo@dominio.com
# CORS: en producción, el/los dominios del frontend.
# CORS_ORIGIN=https://app.tudominio.com
